{
  "name": "Frappe Lab: Frappe + ERPNext",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "remoteUser": "frappe",
  "remoteEnv": {
    "LAB_PRESET": "erpnext"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [
    8000,
    9000,
    6787
  ],
  "portsAttributes": {
    "8000": {
      "label": "Frappe Desk",
      "onAutoForward": "notify"
    },
    "9000": {
      "label": "Socket.IO",
      "onAutoForward": "silent"
    },
    "6787": {
      "label": "Asset watcher",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash /workspace/scripts/bootstrap.sh",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "visualstudioexptteam.vscodeintellicode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/frappe-bench/env/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "debug.node.autoAttach": "disabled"
      }
    }
  }
}
